# ---------------------------------------------------------------------------
# AI CNC Manufacturing Intelligence Platform - environment template
# Copy to .env and edit. Never commit a populated .env.
# ---------------------------------------------------------------------------

# Transactional metadata store. SQLite is for local development only;
# pilot and production deployments must use PostgreSQL (PRD 7.2).
MIP_DATABASE_URL=sqlite:///./var/mip.db
# MIP_DATABASE_URL=postgresql+psycopg://mip:mip@localhost:5432/mip

# Object storage root for immutable source artifacts and derivatives.
# Large CAD/image blobs never live in relational tables (PRD 7.2).
MIP_OBJECT_STORE=./var/object-store

# Signing / token secrets. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
MIP_JWT_SECRET=change-me-in-every-environment
MIP_RELEASE_SIGNING_SECRET=change-me-in-every-environment
MIP_ACCESS_TOKEN_MINUTES=720

# Ingest guards for untrusted uploads (PRD 7.3)
MIP_MAX_UPLOAD_BYTES=268435456
MIP_MAX_ARCHIVE_RATIO=120

# Compute workers for reconstruction / CAM / simulation jobs
MIP_WORKER_THREADS=2
MIP_JOB_POLL_SECONDS=0.5

# Seed the demonstration tenant, factory twin and benchmark part on first boot
MIP_SEED_DEMO=true

# CORS origins for the web application
MIP_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Frontend -> API base URL (read at build time by Vite)
VITE_API_BASE=http://localhost:8000
